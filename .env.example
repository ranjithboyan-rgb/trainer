# ── FitMonk Trainer environment ─────────────────────────────────────────────
# Copy to `.env.local` and fill in. With NONE of these set, the app boots in
# DEMO mode (no auth, in-memory seed data) so you can click through immediately.

# Supabase (project settings → API). Setting these switches the app to real,
# RLS-enforced data + Google sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (service role bypasses RLS). Required in production NOW — it powers
# the public client action page (/c/<token>), which has no logged-in trainer.
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Business Cloud API (milestone M2 — not needed for M1) ───────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# ── Anthropic (optional — parsing dictated notes, post-M1) ──────────────────
ANTHROPIC_API_KEY=
